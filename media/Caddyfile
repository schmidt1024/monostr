# No client address is ever stored (spec section 6). Two things are needed for
# that: no "log" directive in the site block (no access log), and the error
# log of the HTTP handlers switched off - when the upstream is down, Caddy
# writes the failed request there, client address included.
{
	log {
		exclude http.log.error
	}
}

{$MEDIA_DOMAIN:media.monostr.com} {
	# a video may be 50 MiB = 52 428 800 bytes (spec 2026-10-27 video §6); Caddy reads "MB" as 10^6, so 55MB
	# leaves room for the request around the body; the server caps videos and pictures exactly itself
	request_body {
		max_size 55MB
	}
	reverse_proxy media:8080
}
