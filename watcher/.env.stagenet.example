# Stagenet profile: docker compose -f compose.stagenet.yml --env-file .env.stagenet up -d --build
# The public entry point is the mainnet compose's caddy (stagenet.watcher.monostr.com).
# Nostr key of the watcher (hex, 64 chars). Generate on the host: openssl rand -hex 32
WATCHER_SECRET_KEY=
WATCHER_PUBLIC_URL=https://stagenet.watcher.monostr.com
# Advertised in /v1/info; the watcher itself uses ws://stagenet-relay:7777 on the compose network.
WATCHER_PUBLIC_RELAYS=wss://stagenet.watcher.monostr.com/relay
WATCHER_RELAY_LIST_RELAYS=wss://stagenet.watcher.monostr.com/relay
# From: docker compose -f compose.stagenet.yml --env-file .env.stagenet exec stagenet-lws monero-lws-admin --network stage create_admin (JSON field "key")
LWS_ADMIN_KEY=
