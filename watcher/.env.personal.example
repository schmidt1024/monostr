# Copy to .env and fill in. Setup: SELFHOST.md, "Personal watcher".

# Nostr key the watcher signs receipts and its status with. Generate: openssl rand -hex 32
WATCHER_SECRET_KEY=

# Your npub: the account whose tips this watcher confirms.
WATCHER_RECIPIENT=

# Your tip wallet: primary address (starts with 4) and private view key (64 hex).
# Use a wallet only for tips: the view key shows every incoming payment.
WATCHER_ADDRESS=
WATCHER_VIEW_KEY=

WATCHER_NETWORK=mainnet
# Network flag of both wallet-rpc containers: empty for mainnet, --stagenet with WATCHER_NETWORK=stagenet.
MONERO_NETWORK_FLAG=

# 1 to 4 relays where senders post tip intents and the watcher posts receipts and status.
WATCHER_RELAYS=wss://relay.monostr.com,wss://nos.lol

# Public nodes (restricted RPC), at least two. Nodes 1, 3, 5, … serve the scan wallet,
# nodes 2, 4, 6, … a second wallet that must confirm every payment; no node serves both.
# Changing the list starts fresh wallets. Empty = built-in list of independent nodes
# (none run by monostr).
# Stagenet has no built-in list: set WATCHER_NODES to at least two stagenet nodes.
# WATCHER_NODES=https://xmr-node.cakewallet.com:18081,https://node.monerodevs.org:18089

# Tor (optional): uncomment both lines.
# COMPOSE_PROFILES=tor
# WATCHER_PROXY=socks5://tor:9050
