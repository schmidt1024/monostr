# Copy to .env and fill in. Setup: SELFHOST.md

# Domain of this watcher; its DNS A/AAAA record must point to this host (Caddy fetches the TLS certificate).
WATCHER_DOMAIN=watcher.example.com

# Nostr key the watcher signs receipts with (64 hex chars). Generate: openssl rand -hex 32
WATCHER_SECRET_KEY=

# Who may register a wallet here: your npub(s), comma-separated. Empty = anyone.
WATCHER_ALLOWED_PUBKEYS=

# Relays the watcher reads tip intents from and publishes receipts to (optional).
# WATCHER_RELAYS=wss://relay.monostr.com,wss://relay.damus.io,wss://nos.lol
