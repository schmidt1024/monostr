# Nostr key of the watcher (hex, 64 chars). Generate on the host: openssl rand -hex 32
WATCHER_SECRET_KEY=
WATCHER_NETWORK=mainnet
# WATCHER_RELAYS and WATCHER_PUBLIC_RELAYS are set in compose.yml (`environment:` wins over
# this file) — change them there.
WATCHER_RELAY_LIST_RELAYS=wss://purplepag.es,wss://relay.damus.io
WATCHER_PUBLIC_URL=https://watcher.monostr.com
# From: docker compose exec monero-lws monero-lws-admin create_admin (JSON field "key")
LWS_ADMIN_KEY=
WATCHER_DOMAIN=watcher.monostr.com
WATCHER_STAGENET_DOMAIN=stagenet.watcher.monostr.com
